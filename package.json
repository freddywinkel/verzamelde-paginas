{
  "name": "verzamelde-paginas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/clean-build.mjs && vinext build",
    "build:pages": "node scripts/clean-pages-build.mjs && vite build --config vite.pages.config.ts && node scripts/finalize-pages-build.mjs",
    "start": "vinext start",
    "test": "npm run build && npm run build:pages && node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts && npm run privacy:check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern pages-dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern private-import",
    "privacy:check": "node scripts/verify-private-boundary.mjs",
    "privacy:source": "node scripts/verify-public-source.mjs",
    "privacy:strict": "node scripts/verify-private-boundary.mjs --require-private && node scripts/verify-public-source.mjs --require-private",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run privacy:source",
    "release:local": "npm run release:check && npm run privacy:strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.1"
  },
  "type": "module"
}
